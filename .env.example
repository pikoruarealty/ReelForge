# No API keys required for DEMO_MODE=true. Never commit .env.
PORT=8787
DEMO_MODE=true
# API credentials for DEMO_MODE=false; billing is separate from Claude chat subscriptions
OPENROUTER_API_KEY=
# Optional direct Anthropic fallback (used only when OPENROUTER_API_KEY is unset)
ANTHROPIC_API_KEY=
## Image generation uses OpenRouter credits; no GOOGLE_API_KEY required
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Defaults match the requested stack. Verify the IDs are available to your API account.
CLAUDE_IDEA_MODEL=anthropic/claude-haiku-4.5
CLAUDE_SCRIPT_MODEL=anthropic/claude-sonnet-4.5
CLAUDE_EVALUATOR_MODEL=anthropic/claude-haiku-4.5
CLAUDE_OPTIMIZER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_FALLBACK=google/gemini-3.1-flash-image-preview
ELEVENLABS_MODEL=eleven_flash_v2_5
IMAGES_PER_REEL=6
MAX_REVISIONS=3
QUALITY_THRESHOLD=85
# Provider or self-hosted server for local Kokoro via an OpenAI-compatible speech endpoint
KOKORO_API_BASE=http://localhost:8880/v1
KOKORO_VOICE=af_heart
# Set USE_REMOTION=false if your machine cannot launch Chromium/Remotion
USE_REMOTION=true
# Optional word timestamp export. Install services/requirements-optional.txt first.
ENABLE_WHISPER=false
PYTHON_BIN=python3

# Optional AI video motion (paid; enable after still-only test)
MOTION_ENABLED=false
MOTION_MODEL=bytedance/seedance-2.0-mini
MOTION_RESOLUTION=480p
MOTION_SCENE_INDICES=1,3
MOTION_MAX_CLIPS=2
MOTION_ALLOW_STILL_FALLBACK=true
MOTION_POLL_TIMEOUT_SECONDS=1200
# MOTION_PUBLIC_MEDIA_BASE_URL=https://your-public-media-host.example/media

# Motion-graphics-first template: animated counters, step cards, text, comparisons
RENDER_STYLE=motion_graphics
# Zero-indexed scenes which receive real generated images in motion-graphics mode.
# Other scenes use local decorative SVG assets to avoid unnecessary image API costs.
GRAPHICS_IMAGE_SCENES=2,4
# Set RENDER_STYLE=cinematic for the old full-image visual style.

# Caching and regeneration are built in. Use the UI's Testing mode to reuse
# completed assets or Fresh Generation mode for new live content. No key needed
# for repeated local Remotion rendering.

# Brand-specific renderer; default keeps original templates
RENDER_THEME=propshort

# Video renderer: hyperframes (HTML + GSAP, default on this branch) | remotion (legacy, still available)
RENDERER=hyperframes
# HyperFrames render quality: draft | standard | delivery
HYPERFRAMES_QUALITY=delivery
# Optional: path to a royalty-free music file (mp3/wav) mixed under the narration at low volume.
# BACKGROUND_MUSIC=C:/path/to/music.mp3
# Set to false to skip HyperFrames' lint pass before rendering (it fails the job on real errors, ~30 s).
HYPERFRAMES_CHECK=true
# Voiceover budget: if Claude's six narrations total more than this many words, one cheap rewrite pass tightens them
# (real pace is ~2 words/second, so 66 words ~ 30 seconds).
NARRATION_MAX_WORDS=66
# On-screen words while the voice speaks: impact (default: only a few key words, stamped when spoken) | karaoke (word-by-word
# subtitles) | off
CAPTION_MODE=impact
